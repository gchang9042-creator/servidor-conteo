<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Iniciar sesión</title>
    <style>
        body { background-color: #1e2a38; font-family: Segoe UI, sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .caja { background-color: #25384d; padding: 30px; border-radius: 8px; width: 300px; }
        h2 { color: #ecf0f1; text-align: center; }
        input { width: 100%; padding: 8px; margin: 8px 0; border-radius: 4px; border: none; box-sizing: border-box; }
        button { width: 100%; padding: 10px; background-color: #2ecc71; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
        .error { color: #e74c3c; text-align: center; font-size: 13px; }
    </style>
</head>
<body>
    <div class="caja">
        <h2>🚌 Iniciar sesión</h2>
        <form method="POST">
            <input type="text" name="nombre" placeholder="Nombre de cliente" required>
            <input type="password" name="clave" placeholder="Clave secreta" required>
            <button type="submit">Entrar</button>
        </form>
        {% if error %}
            <p class="error">{{ error }}</p>
        {% endif %}
    </div>
</body>
</html>